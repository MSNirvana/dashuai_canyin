{
  "name": "dashuai-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/render/run-worker.ts",
    "render:smoke": "tsx scripts/render-smoke.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc -p tsconfig.typecheck.json",
    "pricing:verify": "tsx scripts/verify-pricing.ts",
    "grant-expiry:run": "tsx scripts/run-grant-expiry.ts",
    "frozen:reconcile": "tsx scripts/reconcile-frozen.ts",
    "payments:verify": "tsx scripts/verify-payments-switch.ts",
    "wxpay:verify": "tsx scripts/verify-wxpay-notify-signature.ts",
    "request-idempotency:verify": "tsx scripts/verify-request-idempotency.ts",
    "bean-bucket:verify": "tsx scripts/verify-consume-bucket-split.ts",
    "grant-buckets:verify": "tsx scripts/verify-grant-buckets.ts",
    "ai-subsidy:report": "tsx scripts/report-ai-subsidy.ts",
    "ai-failover:verify": "tsx scripts/verify-ai-failover.ts",
    "ai-channels:setup": "tsx scripts/setup-ai-channels.ts",
    "storage:gc": "tsx scripts/gc-orphan-objects.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/jsonwebtoken": "^9.0.10",
    "cors": "^2.8.5",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "qcloud-cos-sts": "^3.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
