# ───── 服务基础 ─────
NODE_ENV=development
PORT=3000
# 允许的前端域名（逗号分隔）；留空 = 允许所有（开发期）
CORS_ORIGIN=

# ───── 数据库 / 缓存 ─────
# MySQL 连接串（生产请独立用户 + 强密码）
DATABASE_URL="mysql://dashuai:CHANGE_ME@localhost:3306/dashuai?connection_limit=20"
REDIS_URL="redis://localhost:6379"

# ───── 鉴权 ─────
# JWT 主密钥：生产用 openssl rand -hex 32 生成，32+ 字节
JWT_SECRET="dev-insecure-secret-please-change-me-in-prod"

# ───── 开发登录旁路（仅本地联调，生产务必置 false / 删除）─────
# 开启后：无需真实微信/短信，登录页出现「开发登录」按钮，按手机号直接建号
DEV_LOGIN=true

# ───── 微信小程序（企业主体，需申请「手机号快速验证」）─────
WX_APPID=""
WX_SECRET=""

# ───── AI 通道主密钥（AES-256-GCM，泄露=所有通道 Key 泄露）─────
# 用 openssl rand -hex 32 生成
# 以下为内置 dev 密钥，与 prisma/seed.ts 回退密钥一致，保证本地 seed + 运行一致；
# 生产请替换为自有密钥（改密钥后需重新 db:seed 以重加密通道 Key）
APP_MASTER_KEY="2b3a7c9e1f4d8a6b0c5e2d9f1a7b3c4e6f8a0b1c2d3e4f5a6b7c8d9e0f1a2b3c"

# ───── 渲染 Worker ─────
# true  = 调用真实 ffmpeg 粗剪（需部署机安装 ffmpeg）
# false = 本地/无 ffmpeg 环境，提交即标记 SUCCESS 并返回首镜头素材作为演示成片（demo 闭环）
FFMPEG_WORKER=false

# ───── DeepSeek（可选，真实 AI 通道）─────
# 填入后把 ai_provider.code='deepseek' 的 enabled 改为 true 即可启用真实文案/分镜
DEEPSEEK_API_KEY=""

# ───── 后台管理（/admin/api/v1，单角色全权限）─────
# 默认管理员账号（seed 时创建，scrypt 哈希）；生产务必用 ADMIN_PASSWORD 指定强口令
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123456"
# TTS 配音供应商（腾讯云 / 火山）API Key 不走环境变量，统一在后台「供应商配置」录入并加密存储

# ───── 短信（腾讯云 / 阿里云，待接入）─────
SMS_PROVIDER=""
SMS_SECRET_ID=""
SMS_SECRET_KEY=""
SMS_SIGN=""
SMS_TEMPLATE_ID=""

# ───── 微信支付（商户号，最高优先级，审核不计入工期）─────
WX_PAY_MCH_ID=""
WX_PAY_API_KEY_V3=""
WX_PAY_SERIAL_NO=""
WX_PAY_PRIVATE_KEY=""
WX_PAY_NOTIFY_URL="https://REPLACE_ME.example.com/api/v1/pay/notify"

# ───── 对象存储（素材直传，单文件最大 2GB）─────
COS_BUCKET=""
COS_REGION=""
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BASE_URL="https://REPLACE_ME.cos.example.com"

# ───── 前端 ─────
# 小程序端 dev 用本机局域网 IP；prod 用已备案 HTTPS 域名（且加入 request 合法域名）
