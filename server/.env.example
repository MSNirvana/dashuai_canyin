# ───── 服务基础 ─────
NODE_ENV=development
PORT=3000
# 允许的前端域名（逗号分隔）；留空 = 允许所有（开发期）
CORS_ORIGIN=

# ───── 数据库 / 缓存 ─────
# MySQL 连接串（生产请独立用户 + 强密码）
DATABASE_URL="mysql://dashuai:CHANGE_ME@localhost:3306/dashuai?connection_limit=20"
REDIS_URL="redis://localhost:6379"

# ───── 鉴权 ─────
# JWT 主密钥：生产用 openssl rand -hex 32 生成，32+ 字节
JWT_SECRET="dev-insecure-secret-please-change-me-in-prod"

# ───── 开发登录旁路（仅本地联调，生产务必置 false / 删除）─────
# 开启后：无需真实微信/短信，登录页出现「开发登录」按钮，按手机号直接建号
DEV_LOGIN=true

# ───── 微信小程序（企业主体，需申请「手机号快速验证」）─────
WX_APPID=""
WX_SECRET=""

# ───── AI 通道主密钥（AES-256-GCM，泄露=所有通道 Key 泄露）─────
# 用 openssl rand -hex 32 生成
# 以下为内置 dev 密钥，与 prisma/seed.ts 回退密钥一致，保证本地 seed + 运行一致；
# 生产请替换为自有密钥（改密钥后需重新 db:seed 以重加密通道 Key）
APP_MASTER_KEY="2b3a7c9e1f4d8a6b0c5e2d9f1a7b3c4e6f8a0b1c2d3e4f5a6b7c8d9e0f1a2b3c"

# ───── ChatCut MCP（可选；AI 档生产环境建议配置 OAuth 自动续期）─────
# MCP endpoint 与 tools/list 返回的真实工具名；不要猜工具名
CHATCUT_MCP_URL="https://api.chatcut.io/api/external-mcp/mcp"
CHATCUT_MCP_SURFACE="codex"
CHATCUT_MCP_ACCESS_TOKEN=""
# 首次 OAuth 授权取得；不要提交到 Git。配置后服务端可自动续期 access token
CHATCUT_OAUTH_REFRESH_TOKEN=""
CHATCUT_OAUTH_TOKEN_URL=""
CHATCUT_OAUTH_CLIENT_ID=""
CHATCUT_OAUTH_CLIENT_SECRET=""
# access token 剩余不足该秒数时刷新；静态 token 可用 CHATCUT_MCP_ACCESS_TOKEN_EXPIRES_AT 标注过期时间
CHATCUT_OAUTH_REFRESH_SKEW_SECONDS=300
CHATCUT_MCP_ACCESS_TOKEN_EXPIRES_AT=""
CHATCUT_OAUTH_TIMEOUT_MS=15000
CHATCUT_MCP_TIMEOUT_MS=120000
CHATCUT_MCP_SUBMIT_TOOL=""
CHATCUT_MCP_STATUS_TOOL=""

# ───── 发布素材封面（出图，2026-09-21 新增）─────
# 「合成成片」页的「生成发布素材」会调一次出图模型，出一张 3:4 竖版封面。
# ★ 出图走**独立通道**（tokenbox-image），Key 环境变量是 TB_IMAGE_KEY，
#   在跑通道配置脚本时给：TB_IMAGE_KEY=sk-xxx npm run ai-channels:setup
#   （模型码与出图通道的说明见 scripts/setup-ai-channels.ts 的文件头；
#     价在 prisma/prompts.ts 的 PUBLISH_SCENES.publish_cover，是**固定价**而非上限）
#
# 出图请求的尺寸。默认 1024x1365（原生 864x1152、落盘约 1086x1448，比例正好 3:4）。
# ⚠ 别改成 1024x1536（那是 2:3）或 1024x1024（1:1）—— 产品要的是 3:4 竖版。
# ⚠ 换尺寸要连带改 prompts.ts 里 publish_cover 的 beanPrice（成本变了）。
# AI_IMAGE_SIZE=1024x1365
#
# 取图走的 HTTP 代理。**只有本机联调需要**：部分本机网络会在 TLS 阶段按域名
# 拦掉图床（download.xmimage2.cc.cd），生产实测直连可达 ⇒ **线上不要设**。
# ⚠ 它只作用于「把出好的图下载回来」这一步（走 curl），不影响调 AI 接口。
# OUTBOUND_HTTPS_PROXY=http://127.0.0.1:7897

# ───── 渲染 Worker ─────
# true  = 调用真实 ffmpeg 粗剪（需部署机安装 ffmpeg）
# false = 演示模式：提交即标记 SUCCESS 并返回首镜头素材（不生成新视频）
FFMPEG_WORKER=true
STORAGE_MODE=local
# local 模式的文件根目录；COS 模式不使用此项
LOCAL_STORAGE_DIR=./storage
# 真机调试时改为本机局域网 IP，例如 http://192.168.1.20:3000/api/v1/media
LOCAL_MEDIA_BASE_URL=http://127.0.0.1:3000/api/v1/media

# ───── DeepSeek（可选，真实 AI 通道）─────
# 填入后把 ai_provider.code='deepseek' 的 enabled 改为 true 即可启用真实文案/分镜
DEEPSEEK_API_KEY=""

# ───── 后台管理（/admin/api/v1，单角色全权限）─────
# 默认管理员账号（seed 时创建，scrypt 哈希）；生产务必用 ADMIN_PASSWORD 指定强口令
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123456"
# TTS 配音供应商（腾讯云 / 火山）API Key 不走环境变量，统一在后台「供应商配置」录入并加密存储

# ───── 短信登录（腾讯云，备选通道）─────
# ⚠ 变量名必须是 TENCENT_SMS_* —— 代码只读这几个（server/src/auth/sms-provider.ts）。
#   旧文档写过的 SMS_SECRET_ID / SMS_SECRET_KEY / SMS_SIGN 这些名字**代码从未读取**，
#   照着填会静默不生效。详见 deploy/短信登录接入清单.md
# 五项缺任一 = 通道未配置（短信入口 1004/503），但不会阻止服务启动。
# ⚠ 本文件提交进仓库，只放占位符；真值填 .env（已被 .gitignore 忽略）
SMS_PROVIDER=""
TENCENT_SMS_SECRET_ID=""
TENCENT_SMS_SECRET_KEY=""
TENCENT_SMS_SDK_APP_ID=""
TENCENT_SMS_SIGN_NAME=""
TENCENT_SMS_TEMPLATE_ID=""

# 联调期固定测试码（登录**后门**）
# 作用：签名没过审 / 通道没开时，也能用固定验证码把「手机号+验证码登录」整条链路跑通。
# 四道闸门缺一不可，缺任一 = 自动关闭（见 server/src/auth/sms.ts::smsTestCodeConfig）：
#   ① NODE_ENV !== 'production'（生产整块失效）
#   ② SMS_TEST_CODE 必须是 6 位数字，留空即关闭
#   ③ SMS_TEST_CODE_PHONES 必须**非空**且包含该手机号（故意不支持"留空=所有号"）
#   ④ 若在 production：必须**再**声明 SMS_TEST_CODE_ALLOW_PROD=true 才生效
# 仍然要求先点「获取验证码」：只替换码值，不豁免发送记录/每日限额/IP 限频。
# ⚠ 白名单号在启用期间**收不到真实短信** —— 要验真实发送，请换个不在名单里的号。
# ⚠⚠ 第 ④ 条是**生产环境的登录后门**：只应在「正式登录通道（短信签名报备中 + 小程序未认证）两条都不通」
#     的测试期临时开，并且**只在服务器 .env 里开**。备案 / 小程序认证通过后，
#     必须把 SMS_TEST_CODE / SMS_TEST_CODE_PHONES / SMS_TEST_CODE_ALLOW_PROD / DEV_LOGIN 一起从服务器 .env 删掉。
# SMS_TEST_CODE=""
# SMS_TEST_CODE_PHONES=""
# SMS_TEST_CODE_ALLOW_PROD=""

# ───── 微信支付（商户号，最高优先级，审核不计入工期）─────
WX_PAY_MCH_ID=""
WX_PAY_API_KEY_V3=""
WX_PAY_SERIAL_NO=""
WX_PAY_PRIVATE_KEY=""
WX_PAY_NOTIFY_URL="https://REPLACE_ME.example.com/api/v1/pay/notify"

# ───── 对象存储（素材直传，单文件最大 2GB）─────
COS_BUCKET=""
COS_REGION=""
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BASE_URL="https://REPLACE_ME.cos.example.com"

# ───── AI 通道健康体检（30 分钟一轮，自动停用 / 自动启用）─────
# 逻辑见 server/src/ai/ai-health.service.ts。**留空即用下面的默认值**，一般不需要配。
# 想临时关掉体检：把 AI_HEALTH_SWEEP_MS 设成很大的数（如 86400000），改完需要
# `pm2 restart dashuai-api --update-env` 才生效。
#
# ⚠ 两个最要紧的数字，改之前先读 ai-health.service.ts 的文件头：
#   · AI_HEALTH_PROBE_TIMEOUT_MS = 「多慢算死」的门槛。**不能调小**：
#     gpt-5.5 实测回完一句 30 字概括要 36~52s（且出现过 >120s），
#     10s/30s 会把它判成死并自动停用 —— 而它是 9 个文案场景的默认模型，
#     误停用会把流量全压到更贵的备用通道（单次 116~156 分 vs 售价 62.5 分）。
#   · AI_HEALTH_EVIDENCE_MS = 真实证据窗口。窗口内有**真实调用成功**的通道
#     直接免探测、也不停用（真实证据优先于合成探测）。设 0 会退化成「纯合成探测判活」，
#     在我们这套上游上会误停用可用通道，**不建议**。
# AI_HEALTH_SWEEP_MS=1800000          # 体检周期，默认 30 分钟（下限 60s）
# AI_HEALTH_PROBE_TIMEOUT_MS=90000    # 单次探活超时，默认 90s（下限 5s）
# AI_HEALTH_RETRY_ROUNDS=3            # 首次失败后再复检几轮，默认 3（全失败才停用）
# AI_HEALTH_RETRY_DELAY_MS=3000       # 复检之间的间隔，默认 3s
# AI_HEALTH_GAP_MS=1000               # 通道之间的间隔，默认 1s（三条通道共用同一上游网关，串行探活避免自伤）
# AI_HEALTH_FIRST_DELAY_MS=120000     # 启动后首次执行的延迟，默认 120s（避开部署刚重启的上游预热期）
# AI_HEALTH_EVIDENCE_MS=86400000      # 真实证据窗口，默认 24h（见上）

# ───── 前端 ─────
# 小程序端 dev 用本机局域网 IP；prod 用已备案 HTTPS 域名（且加入 request 合法域名）
