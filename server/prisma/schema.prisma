// 大帅餐饮短视频创作工具 · 数据模型
// 生成：npx prisma generate ／ 迁移：npx prisma migrate dev
// 约定：金额用「分」，AI 价格用「分/百万 tokens」，时间存 UTC

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt()
  phone                String    @unique @db.VarChar(20)
  wechatOpenid         String?   @unique @map("wechat_openid") @db.VarChar(64)
  wechatUnionid        String?   @map("wechat_unionid") @db.VarChar(64)
  nickname             String?   @db.VarChar(64)
  // 两列不同源，**不要互相覆盖**：
  //   avatarUrl = 微信侧返回的**外部**头像链接（原样存，可能是 https 链接）
  //   avatarKey = 我们自己存储里的**对象键**（用户在「个人主页」自传的头像）
  // ⚠ avatarKey 是对象键列 ⇒ 必须同步进 gc-orphan-objects.ts::collectReferencedKeys()，
  //   否则 GC 会在保留期后把在用的头像当孤儿删掉。
  avatarUrl            String?   @db.VarChar(512)
  avatarKey            String?   @map("avatar_key") @db.VarChar(512)
  status               String    @default("ACTIVE") @db.VarChar(16)
  registerGrantGranted Boolean   @default(false) @map("register_grant_granted")
  lastLoginAt          DateTime? @map("last_login_at") @db.DateTime(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt            DateTime? @map("deleted_at") @db.DateTime(3)

  stores              Store[]
  personas            Persona[]
  creations           Creation[]
  beanAccount         BeanAccount?
  ledgers             BeanLedger[]
  orders              Order[]
  memberships         Membership[]
  aiCallLogs          AiCallLog[]
  renderTasks         RenderTask[]
  businessRequests    BusinessRequest[]
  beanReservations    BeanReservation[]
  membershipReminders MembershipReminder[]

  @@map("merchant")
}

model Store {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt()
  merchantId BigInt    @map("merchant_id") @db.UnsignedBigInt()
  name       String    @db.VarChar(128)
  category   String?   @db.VarChar(64)
  province   String?   @db.VarChar(64)
  city       String?   @db.VarChar(64)
  district   String?   @db.VarChar(64)
  address    String?   @db.VarChar(255)
  contact    String?   @db.VarChar(64)
  coverKey   String?   @map("cover_key") @db.VarChar(512)
  // 门店介绍：一两句话说明门店特色，用于门店详情页统一展示
  intro      String?   @db.VarChar(500)
  // 门店视频（可选）：门店环境/招牌短视频，仅作门店展示，不进创作素材池
  videoKey   String?   @map("video_key") @db.VarChar(512)
  isDefault  Boolean   @default(false) @map("is_default")
  status     String    @default("ACTIVE") @db.VarChar(16)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt  DateTime? @map("deleted_at") @db.DateTime(3)

  merchant  Merchant     @relation(fields: [merchantId], references: [id])
  dishes    Dish[]
  assets    MediaAsset[]
  creations Creation[]
  persona   Persona?

  @@index([merchantId, deletedAt])
  @@map("store")
}

model Dish {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt()
  storeId       BigInt    @map("store_id") @db.UnsignedBigInt()
  name          String    @db.VarChar(128)
  intro         String?   @db.VarChar(500)
  sellingPoints String?   @map("selling_points") @db.VarChar(1000)
  coverKey      String?   @map("cover_key") @db.VarChar(512)
  videoKey      String?   @map("video_key") @db.VarChar(512)
  sort          Int       @default(0)
  status        String    @default("ACTIVE") @db.VarChar(16)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt     DateTime? @map("deleted_at") @db.DateTime(3)

  store     Store       @relation(fields: [storeId], references: [id])
  creations Creation[]
  media     DishMedia[]

  @@index([storeId, deletedAt, sort])
  @@map("dish")
}

model Persona {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt()
  merchantId BigInt   @map("merchant_id") @db.UnsignedBigInt()
  // 门店级：一门店一条人设，内容（菜品/创作/人设）全部跟随门店
  storeId    BigInt   @unique @map("store_id") @db.UnsignedBigInt()
  bossTags   String?  @map("boss_tags") @db.VarChar(500)
  activity   String?  @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  merchant Merchant @relation(fields: [merchantId], references: [id])
  store    Store    @relation(fields: [storeId], references: [id])

  @@map("persona")
}

model MediaAsset {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt()
  merchantId BigInt    @map("merchant_id") @db.UnsignedBigInt()
  storeId    BigInt    @map("store_id") @db.UnsignedBigInt()
  ownerType  String    @map("owner_type") @db.VarChar(24)
  ownerId    BigInt?   @map("owner_id") @db.UnsignedBigInt()
  type       String    @db.VarChar(16)
  cosKey     String    @map("cos_key") @db.VarChar(512)
  bucket     String    @db.VarChar(128)
  region     String    @db.VarChar(64)
  sizeBytes  BigInt    @default(0) @map("size_bytes") @db.UnsignedBigInt()
  durationMs Int?      @map("duration_ms") @db.UnsignedInt()
  width      Int?
  height     Int?
  coverKey   String?   @map("cover_key") @db.VarChar(512)
  status     String    @default("READY") @db.VarChar(16)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  deletedAt  DateTime? @map("deleted_at") @db.DateTime(3)

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, type, deletedAt])
  @@index([ownerType, ownerId])
  @@map("media_asset")
}

model DishMedia {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt()
  dishId    BigInt   @map("dish_id") @db.UnsignedBigInt()
  type      String   @db.VarChar(16)
  cosKey    String   @map("cos_key") @db.VarChar(512)
  coverKey  String?  @map("cover_key") @db.VarChar(512)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@index([dishId, type, sort])
  @@map("dish_media")
}

model Creation {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt()
  merchantId BigInt    @map("merchant_id") @db.UnsignedBigInt()
  storeId    BigInt    @map("store_id") @db.UnsignedBigInt()
  dishId     BigInt?   @map("dish_id") @db.UnsignedBigInt()
  title      String?   @db.VarChar(255)
  // 「你想怎么拍？」—— 用户自己写的一句话（选填，≤200 字）。
  // 会作为 {{userIdea}} 进提示词，且在文案与分镜两个场景里都是**最高优先级**的内容要求。
  // 存成列而不是只当请求参数：重试 / 换一款 / 重新生成分镜时都要复用同一句话，
  // 让用户重填一遍是没道理的（文案与分镜是两次独立调用，参数里各带一份很容易漂）。
  userIdea   String?   @map("user_idea") @db.VarChar(200)
  track      String    @db.VarChar(24)
  complexity String    @db.VarChar(16)
  copyText   String?   @map("copy_text") @db.Text
  status     String    @default("DRAFT") @db.VarChar(24)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  // 软删除：非空即"已删"，列表一律排除。本项目既有的删除语义就是这个
  // （listCreations 早就在过滤 deletedAt: null），不要再另造一套物理删除。
  deletedAt  DateTime? @map("deleted_at") @db.DateTime(3)
  // 归档：非空即"已归档"，默认列表排除、只在「归档」分类里出现。
  // 与 status 正交 —— status 目前恒为 DRAFT、从不写入，不能拿它当筛选依据。
  archivedAt DateTime? @map("archived_at") @db.DateTime(3)
  // ★「AI 分镜结果的首次应用」标记（见 creation.service.ts::generateShots 的说明）。
  //   storyboard_applied_request_id = 最后一次真正用于重建分镜的 requestId；
  //   storyboard_applied_at         = 那次 AI 请求的**认领时刻**（business_request.created_at），
  //                                   用作单调排序键：只有比它更新的结果才允许覆盖分镜。
  //   没有这两列时：AI 账务层能正确返回缓存结果，但**调用方照样 deleteMany + 重建**，
  //   于是「用户改过分镜 / 绑过素材之后再重放同 requestId」会把用户的编辑全部清掉。
  storyboardAppliedRequestId String?   @map("storyboard_applied_request_id") @db.VarChar(64)
  storyboardAppliedAt        DateTime? @map("storyboard_applied_at") @db.DateTime(3)

  merchant    Merchant     @relation(fields: [merchantId], references: [id])
  store       Store        @relation(fields: [storeId], references: [id])
  dish        Dish?        @relation(fields: [dishId], references: [id])
  shots       Shot[]
  renderTasks RenderTask[]

  @@index([merchantId, deletedAt, createdAt])
  @@map("creation")
}

model Shot {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt()
  creationId      BigInt   @map("creation_id") @db.UnsignedBigInt()
  seq             Int
  // 镜头分类：开场 / 口播 / 特写 / 原料 / 制作 / 环境 / 试吃 / 卖点 / 收尾
  shotType        String?  @map("shot_type") @db.VarChar(64)
  // 景别：远景 / 全景 / 中景 / 近景 / 特写 / 大特写
  shotSize        String?  @map("shot_size") @db.VarChar(16)
  durationSuggest Int?     @map("duration_suggest")
  line            String?  @db.Text
  visualReq       String?  @map("visual_req") @db.Text
  libraryShotId   BigInt?  @map("library_shot_id") @db.UnsignedBigInt()
  assetId         BigInt?  @map("asset_id") @db.UnsignedBigInt()
  trimStartMs     Int      @default(0) @map("trim_start_ms") @db.UnsignedInt()
  trimEndMs       Int?     @map("trim_end_ms") @db.UnsignedInt()
  // 「这个分镜我不拍了」——用户主动跳过素材上传。
  // ★ 必须落库：跳过只写在客户端 state 里的话，一刷新（或换设备）就没了，
  //   而合成页按「有没有 assetId」判断素材是否齐全 ⇒ 跳过等于没跳过，用户被永久挡在合成页外。
  // 不变量：skipped=true 时 assetId 必须为 null（两者互斥，由 updateShotAsset 维持）。
  skipped         Boolean  @default(false) @map("skipped")
  status          String   @default("PENDING") @db.VarChar(16)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  creation Creation @relation(fields: [creationId], references: [id])

  @@unique([creationId, seq])
  @@map("shot")
}

model ShotLibrary {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt()
  code          String    @unique @db.VarChar(64)
  name          String    @db.VarChar(128)
  category      String    @db.VarChar(32)
  tips          String?   @db.Text
  source        String    @default("MANUAL") @db.VarChar(16)
  demoVideoKey  String?   @map("demo_video_key") @db.VarChar(512)
  demoCoverKey  String?   @map("demo_cover_key") @db.VarChar(512)
  sort          Int       @default(0)
  enabled       Boolean   @default(true)
  aiGeneratedAt DateTime? @map("ai_generated_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([category, enabled, sort])
  @@map("shot_library")
}

// 首页「优秀作品」：运营内容，不挂在商家数据上，避免用户删创作/清素材后作品消失
model ExcellentWork {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt()
  title        String    @db.VarChar(128)
  // 一级分类：餐饮 / 教培 / 美业 / 生活服务 / 休闲娱乐
  category     String    @db.VarChar(32)
  // 二级分类（如 卤味 / 火锅 / 美甲），用于标签展示与更细的筛选
  subCategory  String?   @map("sub_category") @db.VarChar(32)
  // 展示用标签数组，如 ["素材智能成片","卤味"]
  tags         Json?
  coverKey     String?   @map("cover_key") @db.VarChar(512)
  videoKey     String?   @map("video_key") @db.VarChar(512)
  durationMs   Int?      @map("duration_ms") @db.UnsignedInt
  // 同款配方：{ track, complexity, titleHint, voiceId, shotSkeleton[], notes }
  // 「生成同款」把它预填进创作流，这是本模块真正的价值点
  recipeJson   Json      @map("recipe_json")
  sort         Int       @default(0)
  enabled      Boolean   @default(true)
  // MANUAL = 后台直接上传；RENDER = 从商家成功成片里挑入库
  sourceType   String    @default("MANUAL") @map("source_type") @db.VarChar(16)
  sourceTaskId BigInt?   @map("source_task_id") @db.UnsignedBigInt
  viewCount    Int       @default(0) @map("view_count") @db.UnsignedInt
  cloneCount   Int       @default(0) @map("clone_count") @db.UnsignedInt
  publishedAt  DateTime? @map("published_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt    DateTime? @map("deleted_at") @db.DateTime(3)

  @@index([category, enabled, sort])
  @@index([enabled, sort])
  @@map("excellent_work")
}

// 教学中心（小程序「我的」页那个四宫格）：平台级运营内容，视频与封面都由后台管理员上传。
//
// ── 三件事与其它表不同，改这里之前先读 ──────────────────────────────────
// 1) category 是**代码里的固定白名单**（src/lib/tutorial-categories.ts），故意不建分类表：
//    四个入口的文案与图标本来就要写死在客户端（离线也要能显示），建表只会多一份会漂移的真相。
//    schema 里存 String 是本项目一贯做法（全库没有 enum）。
// 2) videoKey / coverKey 是**对象键**，前缀 `tutorials/`。
//    ⚠ 必须同步进 gc-orphan-objects.ts::collectReferencedKeys()：漏了会在保留期（默认 24h）
//      后把在用的教学视频当孤儿删掉 —— 延迟发作、且日志里没有任何报错。
// 3) 删除是**硬删**（没有 deletedAt）：这一行是这些对象的唯一引用，软删会留下永久无法回收的
//    大文件。adminRemoveTutorial() 会连存储里的对象一起删；删失败也不致命，
//    孤儿由 GC 兜底（它比软删更晚，但终究会被回收）。
model TutorialVideo {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt()
  // SHOOTING 拍摄技巧 / EDITING 剪辑教程 / OPERATION 运营知识 / MANUAL 使用手册
  category   String   @db.VarChar(16)
  title      String   @db.VarChar(128)
  videoKey   String?  @map("video_key") @db.VarChar(512)
  coverKey   String?  @map("cover_key") @db.VarChar(512)
  // 由客户端上报（管理员无法从文件里读到时长），只用于列表右侧的「03:12」展示
  durationMs Int?     @map("duration_ms") @db.UnsignedInt
  sort       Int      @default(0)
  // false = 下架：小程序端不再下发，但行与对象都保留（与「删除」区分开）
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([category, enabled, sort])
  @@map("tutorial_video")
}

model RenderTask {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt()
  merchantId    BigInt    @map("merchant_id") @db.UnsignedBigInt()
  creationId    BigInt    @map("creation_id") @db.UnsignedBigInt()
  status        String    @default("QUEUED") @db.VarChar(24)
  progress      Int       @default(0) @db.UnsignedTinyInt()
  // 产品档位：BASIC 粗剪 / AI 全自动 / PREMIUM 人工精剪（技术语义见 paramsJson.mode）
  grade         String    @default("AI") @db.VarChar(16)
  paramsJson    Json      @map("params_json")
  resultKey     String?   @map("result_key") @db.VarChar(512)
  previewKey    String?   @map("preview_key") @db.VarChar(512)
  resultSize    BigInt?   @map("result_size") @db.UnsignedBigInt()
  durationMs    Int?      @map("duration_ms") @db.UnsignedInt()
  errorCode     String?   @map("error_code") @db.VarChar(64)
  errorMsg      String?   @map("error_msg") @db.VarChar(500)
  retryCount    Int       @default(0) @map("retry_count") @db.UnsignedTinyInt()
  beanCharged   BigInt    @default(0) @map("bean_charged")
  cacheHit      Boolean   @default(false) @map("cache_hit")
  requestId     String?   @map("request_id") @db.VarChar(64)
  reservationId BigInt?   @map("reservation_id") @db.UnsignedBigInt()
  queueAt       DateTime? @map("queue_at") @db.DateTime(3)
  startAt       DateTime? @map("start_at") @db.DateTime(3)
  finishAt      DateTime? @map("finish_at") @db.DateTime(3)
  costMs        Int?      @map("cost_ms") @db.UnsignedInt()
  /// worker 租约（fencing token）。认领时写入 owner 并递增 version，心跳只刷新 leaseExpireAt。
  /// ★ 为什么必须落成列而不是塞进 paramsJson：
  ///   ① 回收判据要能走索引、且不能与 `storeChatCutState` 的全量替换 paramsJson 抢读改写；
  ///   ② 收尾（成功/失败/进度）必须能带 `WHERE lease_owner=? AND lease_version=?` 条件，
  ///      否则迟到的旧 owner 会把已被回收重跑的任务覆盖成旧状态（实测能把 SUCCESS 改回 RUNNING）。
  ///   version 在每次认领/回收时自增 ⇒ 旧 owner 手里的旧 version 写入必然 0 行，天然失权。
  leaseOwner    String?   @map("lease_owner") @db.VarChar(64)
  leaseVersion  Int       @default(0) @map("lease_version") @db.UnsignedInt()
  leaseExpireAt DateTime? @map("lease_expire_at") @db.DateTime(3)
  // 精品档：剪辑师接单时间
  assignedAt    DateTime? @map("assigned_at") @db.DateTime(3)
  // 精品档：SLA 截止时间，超时自动退款
  deadlineAt    DateTime? @map("deadline_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  merchant    Merchant         @relation(fields: [merchantId], references: [id])
  creation    Creation         @relation(fields: [creationId], references: [id])
  reservation BeanReservation? @relation(fields: [reservationId], references: [id])

  @@index([creationId, createdAt])
  @@index([status, queueAt])
  // 孤儿回收按「RUNNING + 租约已过期」扫描，缺这个索引会全表扫 RUNNING 行
  @@index([status, leaseExpireAt])
  @@index([grade, status])
  // 后台「合成任务」列表按 merchantId 过滤 + createdAt 倒序分页，缺这个索引会全表扫描。
  // 其余同形态的表（bean_ledger / ai_call_log / `order` / business_request / creation）都已有
  // [merchantId, createdAt]，此前只有 render_task 漏了。
  @@index([merchantId, createdAt])
  @@map("render_task")
}

model BeanAccount {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt()
  merchantId    BigInt   @unique @map("merchant_id") @db.UnsignedBigInt()
  balance       BigInt   @default(0)
  /// 会员周期赠积分：随会员到期清零（由 grant-expiry 调度）
  grantBalance  BigInt   @default(0) @map("grant_balance")
  /// 注册赠积分：拉新奖励，**永久有效、不随会员到期清零**
  /// 与 grantBalance 分开成桶，是因为两者性质不同（拉新承诺 vs 付费周期权益），
  /// 混在一个桶里会导致「会员到期把注册赠积分一起清掉」，且账务上无法区分来源。
  grantRegisterBalance BigInt @default(0) @map("grant_register_balance")
  frozen        BigInt   @default(0)
  totalRecharge BigInt   @default(0) @map("total_recharge")
  totalGrant    BigInt   @default(0) @map("total_grant")
  totalConsume  BigInt   @default(0) @map("total_consume")
  version       Int      @default(0)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("bean_account")
}

model BeanReservation {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt()
  merchantId BigInt   @map("merchant_id") @db.UnsignedBigInt()
  bizType    String   @map("biz_type") @db.VarChar(32)
  bizId      String   @map("biz_id") @db.VarChar(64)
  requestId  String   @map("request_id") @db.VarChar(64)
  reserved   BigInt   @default(0)
  consumed   BigInt   @default(0)
  released   BigInt   @default(0)
  /// ★ 冻结那一刻，本次 reserved 中「从会员赠积分桶预留」的绝对数量。
  /// 不记这一列，到期清零就无从判断「grant_balance 里有多少是已承诺给在途任务的」，
  /// 于是一次会员到期清零能把在途任务的额度一并抹掉 → 可用余额为负 / 结算报「积分不足」。
  grantReserved BigInt @default(0) @map("grant_reserved")
  /// 上一列中来自「注册赠积分」桶的部分（会员桶预留 = grantReserved - grantRegisterReserved）
  grantRegisterReserved BigInt @default(0) @map("grant_register_reserved")
  /// 预留发生时所处的会员周期（membership.id）。仅审计/排查用：
  /// 回答「会员到期后为什么 grant_balance 还剩 5000」= 它属于某个在途预留。
  membershipId  BigInt?  @map("membership_id") @db.UnsignedBigInt()
  status     String   @default("ACTIVE") @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  merchant    Merchant     @relation(fields: [merchantId], references: [id])
  renderTasks RenderTask[]

  @@unique([merchantId, bizType, requestId])
  @@index([merchantId, bizType, bizId])
  @@index([status, updatedAt])
  @@map("bean_reservation")
}

model BusinessRequest {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt()
  merchantId   BigInt   @map("merchant_id") @db.UnsignedBigInt()
  operation    String   @db.VarChar(32)
  requestId    String   @map("request_id") @db.VarChar(64)
  payloadHash  String   @map("payload_hash") @db.Char(64)
  resourceType String?  @map("resource_type") @db.VarChar(32)
  resourceId   BigInt?  @map("resource_id") @db.UnsignedBigInt()
  status       String   @default("PENDING") @db.VarChar(16)
  resultRef    String?  @map("result_ref") @db.VarChar(255)
  errorCode    String?  @map("error_code") @db.VarChar(64)
  errorMsg     String?  @map("error_msg") @db.VarChar(500)
  /// ★ AI 场景的租约（与 render_task 同一套语义）。
  /// 没有它时：进程在「freeze 已提交、结算尚未执行」之间退出，该 requestId 的 PENDING
  /// 预留既不会被重放推进（重放走 ScenePendingError），也没有任何 sweeper 认领 →
  /// 积分永久冻结，且库里看起来完全正常。
  leaseOwner   String?  @map("lease_owner") @db.VarChar(64)
  /// fencing token：每次认领自增，失权执行者的后续写入必须被这条拦住
  leaseVersion Int      @default(0) @map("lease_version") @db.UnsignedInt()
  leaseExpireAt DateTime? @map("lease_expire_at") @db.DateTime(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, operation, requestId])
  @@index([merchantId, operation, createdAt])
  @@index([status, updatedAt])
  @@index([status, leaseExpireAt])
  @@map("business_request")
}

model BeanLedger {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt()
  merchantId   BigInt   @map("merchant_id") @db.UnsignedBigInt()
  type         String   @db.VarChar(24)
  bucket       String   @default("RECHARGE") @db.VarChar(16)
  amount       BigInt
  /// 本行 amount 中来自「赠积分桶」的绝对数量（>=0）。
  /// bucket 只能标一个主桶，混合消费（赠积分 + 充值积分）时会失真，故单独留一列做精确对账。
  grantAmount  BigInt   @default(0) @map("grant_amount")
  /// 上一列中，来自「注册赠积分」桶的部分（会员赠积分用量 = grantAmount - grantRegisterAmount）。
  grantRegisterAmount BigInt @default(0) @map("grant_register_amount")
  balanceAfter BigInt   @map("balance_after")
  grantAfter   BigInt   @default(0) @map("grant_after")
  frozenAfter  BigInt   @default(0) @map("frozen_after")
  bizType      String?  @map("biz_type") @db.VarChar(32)
  bizId        String?  @map("biz_id") @db.VarChar(64)
  requestId    String?  @map("request_id") @db.VarChar(64)
  remark       String?  @db.VarChar(255)
  operatorId   BigInt?  @map("operator_id") @db.UnsignedBigInt()
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  merchant Merchant @relation(fields: [merchantId], references: [id])

  // 幂等键必须包含商家，避免不同租户的 requestId 互相冲突
  @@unique([merchantId, bizType, requestId, type])
  @@index([merchantId, createdAt])
  @@index([bizType, bizId])
  @@map("bean_ledger")
}

