/// 结算回执 —— 「订单已 PAID」这件事的**唯一凭据**。
///
/// ★ 为什么需要它（而不是靠推断权益反推）：
///   `markOrderPaid()` 把「PENDING → PAID 的终态 CAS」与「发积分 / 开会员」放在**同一个事务**里，
///   所以今天 `PAID ⇒ 权益已发` 在结构上成立。但这条不变量**只存在于注释里**，
///   没有任何机器可验证的证据 —— 一旦将来有人在事务外补一条 `order.update({status:'PAID'})`
///   （或手工改库），就会出现「钱收了、货没发」而我们**完全不知道**。
///
///   想用权益表反推是**不可靠**的，两处都会误报：
///     · MEMBER 续期时 `Membership.sourceOrderId` 仍指向**上一张**订单，不是本次这张；
///     · `grantPoints = 0` 时 `grant()` 根本不会被调用（order.service.ts 的 `if (grantPoints > 0n)`），
///       于是「没有任何流水」既可能是没发、也可能是本就该发 0。
///
///   回执在**同一事务内**写入 ⇒ 它存在 ⟺ 事务提交 ⟺ 权益已发，判据唯一且无需启发式。
///   顺带把「本次到底发了多少」留痕，这是对账真正需要的那一列。
model OrderSettlement {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt()
  /// 一张订单只结算一次（终态 CAS 保证）⇒ 天然唯一，可当幂等锚点
  orderId         BigInt    @unique @map("order_id") @db.UnsignedBigInt()
  orderNo         String    @map("order_no") @db.VarChar(64)
  merchantId      BigInt    @map("merchant_id") @db.UnsignedBigInt()
  orderType       String    @map("order_type") @db.VarChar(24)
  amountFen       Int       @map("amount_fen") @db.UnsignedInt()
  /// 本次实际发放：BEAN = 充值的积分数；MEMBER = 赠送的积分数
  grantedBeans    BigInt    @default(0) @map("granted_beans")
  /// MEMBER 专用：本次结算后的会员到期时间（续期时是顺延后的新值）
  membershipEndAt DateTime? @map("membership_end_at") @db.DateTime(3)
  /// 结算来源，便于事后区分「正常回调」与「兜底补单」：
  /// NOTIFY = 微信回调 / QUERY = 用户端主动查单 / RECONCILE = 后台人工补单
  /// RISK = 窗口外取证扫描 / ADMIN = 后台手动开通 / DEMO = 演示支付
  source          String    @db.VarChar(24)
  wxTransactionId String?   @map("wx_transaction_id") @db.VarChar(128)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([merchantId, createdAt])
  @@index([orderType, createdAt])
  @@map("order_settlement")
}

model AiProvider {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt()
  code              String    @unique @db.VarChar(64)
  name              String    @db.VarChar(128)
  providerType      String    @map("provider_type") @db.VarChar(32)
  protocol          String    @default("OPENAI_COMPATIBLE") @db.VarChar(32)
  baseUrl           String    @map("base_url") @db.VarChar(512)
  apiKeyEncrypted   Bytes     @map("api_key_encrypted") @db.VarBinary(1024)
  apiKeyMasked      String?   @map("api_key_masked") @db.VarChar(64)
  enabled           Boolean   @default(true)
  priority          Int       @default(100)
  healthStatus      String    @default("HEALTHY") @map("health_status") @db.VarChar(16)
  /// 这行 enabled=false 是**健康体检 sweeper 自己**写下的（不是运营点的）。
  /// ★ 为什么必须单独加一列，而不是「enabled=false 就一律当成是 sweeper 关的」：
  ///   运营手动停用要**永久**生效（成本太高 / 已废弃 / 换供应商），而 sweeper 的停用必须
  ///   在下次探测通过后自动打开。两种「关」混在一个布尔位上，sweeper 一定会在某个凌晨
  ///   把运营故意关掉的通道打开 —— 或者反过来，永远不再探活一个其实能用的通道。
  ///   ⇒ 语义：autoDisabled=true 表示「sweeper 拥有这行的开/关」，运营任何一次显式写 enabled
  ///     都会把它清回 false（运营意图优先，sweeper 从此不再碰它的开/关）。
  autoDisabled      Boolean   @default(false) @map("auto_disabled")
  circuitOpenUntil  DateTime? @map("circuit_open_until") @db.DateTime(3)
  /// 请求路径上**连续**的「通道级硬故障」次数（TIMEOUT / NETWORK / 401 / 403 / 429 / 5xx）。
  /// 任何一次成功（含备用通道顶上来之后它自己的成功）立刻清零。
  ///
  /// ★★ 为什么必须存在这一列（2026-09-23）：
  ///   在这之前，「这个通道最近是不是在连续失败」在整个系统里**无法回答**——
  ///   · `ai_call_log` **只在成功时写**（gateway 的 create 在 try 内），失败/超时不留痕；
  ///   · Redis 里的熔断只有一个 `EX 300` 的一次性标记，5 分钟后就遗忘；
  ///   · 健康体检的判据是「24h 内有过一次真实成功 ⇒ 免检」，**通道级**而非场景级
  ///     ⇒ 一个通道在某场景上跑飞超时，只要它在别的场景成功过一次，就永远判「可用」。
  ///   实测后果：deepseek 在 storyboard 上思考跑飞 108~147s，越过 150s 超时才降级到
  ///   claude（41s），用户实等 191 秒；而体检全程判它 HEALTHY。
  ///   ⇒ 失败必须变成**信号**，而且这个信号要能比「某处成功过一次」更强。
  consecutiveFailures Int      @default(0) @map("consecutive_failures") @db.UnsignedInt()
  lastFailureAt     DateTime? @map("last_failure_at") @db.DateTime(3)
  /// `AiCallError.code`（TIMEOUT / NETWORK / HTTP_429 / …）—— 让后台能显示「为什么」而不只是「失败了」
  lastFailureCode   String?   @map("last_failure_code") @db.VarChar(64)
  lastFailureMsg    String?   @map("last_failure_msg") @db.VarChar(500)
  lastTestAt        DateTime? @map("last_test_at") @db.DateTime(3)
  lastTestLatencyMs Int?      @map("last_test_latency_ms")
  lastTestStatus    String?   @map("last_test_status") @db.VarChar(16)
  lastTestError     String?   @map("last_test_error") @db.VarChar(500)
  monthlyBudgetFen  Int?      @map("monthly_budget_fen") @db.UnsignedInt()
  usedBudgetFen     Int       @default(0) @map("used_budget_fen") @db.UnsignedInt()
  budgetResetAt     DateTime? @map("budget_reset_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  models AiModel[]
  logs   AiCallLog[]

  @@index([enabled, priority])
  // ★ 2026-09-21 补声明：`ai_provider_auto_disabled_idx` 由迁移
  //   20260921120000_add_ai_provider_auto_disabled 建立，但当时**漏了在 schema 里声明**
  //   ⇒ 库比 schema 多一个索引。
  //   后果不是功能问题（多一个索引不影响任何查询），而是部署安全网
  //   `deploy/db-baseline.sh --verify` 会**永久报假警**：diff 每次都吐
  //   `DROP INDEX ai_provider_auto_disabled_idx`，久而久之这个断言就没人信了 ——
  //   而它恰恰是「有没有迁移被 migrate resolve 标掉却没执行」的唯一自动检查。
  //   这里只是把库里**已经存在**的索引补声明回来。索引名按 Prisma 默认规则
  //   （`<表>_<列>_idx`）生成，与库中完全一致 ⇒ **不需要新增迁移**。
  @@index([autoDisabled])
  @@map("ai_provider")
}

model AiModel {
  id                 BigInt   @id @default(autoincrement()) @db.UnsignedBigInt()
  providerId         BigInt   @map("provider_id") @db.UnsignedBigInt()
  modelCode          String   @map("model_code") @db.VarChar(128)
  displayName        String   @map("display_name") @db.VarChar(128)
  capability         String   @default("TEXT") @db.VarChar(32)
  maxContextTokens   Int?     @map("max_context_tokens") @db.UnsignedInt()
  maxOutputTokens    Int?     @map("max_output_tokens") @db.UnsignedInt()
  inputPricePerMtok  Int      @default(0) @map("input_price_per_mtok") @db.UnsignedInt()
  outputPricePerMtok Int      @default(0) @map("output_price_per_mtok") @db.UnsignedInt()
  /// 图像模型按张计费，单位为 1e-6 分/张。文本模型保持 0。
  unitPriceMicroFen  BigInt   @default(0) @map("unit_price_micro_fen")
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  provider AiProvider  @relation(fields: [providerId], references: [id])
  logs     AiCallLog[]

  @@unique([providerId, modelCode])
  @@index([enabled])
  @@map("ai_model")
}

model AiScene {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt()
  code             String   @unique @db.VarChar(64)
  name             String   @db.VarChar(128)
  /// 场景种类：TEXT（默认，走 chat/completions 返回文本）| IMAGE（走 images/generations 返回图片 URL）
  ///
  /// ★ 为什么必须有这一列，而不是靠「候选模型的 capability 是不是 IMAGE」推断：
  ///   网关是按 `ai_scene` 的候选链去取模型的，**取到哪个模型**才是决定调哪个协议的依据；
  ///   用模型的 capability 反推场景种类，等于让运营的一次误配（把文本模型填进图像场景）
  ///   静默变成「调 chat 接口、拿一段文字当图片 URL」—— 报错点到为止、钱照扣。
  ///   有了 kind，网关可以在候选模型能力不匹配时**直接跳过并给出明确原因**。
  /// ★ 默认 'TEXT' 且存量全部落在这个默认值上 ⇒ 这次迁移对已有场景是纯加列，语义不变。
  kind             String   @default("TEXT") @db.VarChar(16)
  promptTemplate   String   @map("prompt_template") @db.MediumText
  fallbackTemplate String?  @map("fallback_template") @db.MediumText
  defaultModelId   BigInt   @map("default_model_id") @db.UnsignedBigInt()
  fallbackModelIds Json     @map("fallback_model_ids")
  beanPrice        BigInt   @map("bean_price")
  timeoutMs        Int      @default(30000) @map("timeout_ms") @db.UnsignedInt()
  maxRetries       Int      @default(2) @map("max_retries") @db.UnsignedTinyInt()
  temperature      Decimal? @db.Decimal(3, 2)
  maxOutputTokens  Int?     @map("max_output_tokens") @db.UnsignedInt()
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("ai_scene")
}

model AiCallLog {
  id                  BigInt   @id @default(autoincrement()) @db.UnsignedBigInt()
  merchantId          BigInt?  @map("merchant_id") @db.UnsignedBigInt()
  sceneCode           String   @map("scene_code") @db.VarChar(64)
  requestId           String   @map("request_id") @db.VarChar(64)
  providerId          BigInt   @map("provider_id") @db.UnsignedBigInt()
  modelId             BigInt   @map("model_id") @db.UnsignedBigInt()
  isFallback          Boolean  @default(false) @map("is_fallback")
  fallbackFromModelId BigInt?  @map("fallback_from_model_id") @db.UnsignedBigInt()
  promptTokens        Int      @default(0) @map("prompt_tokens") @db.UnsignedInt()
  completionTokens    Int      @default(0) @map("completion_tokens") @db.UnsignedInt()
  totalTokens         Int      @default(0) @map("total_tokens") @db.UnsignedInt()
  costFen             Int      @default(0) @map("cost_fen") @db.UnsignedInt()
  /// 精确供应商成本，单位为 1e-6 分。costFen 仅保留为向后兼容的展示值。
  costMicroFen        BigInt   @default(0) @map("cost_micro_fen")
  beanCharged         BigInt   @default(0) @map("bean_charged")
  /// 场景单次上限（ai_scene.bean_price）截断掉的积分数 = 应付 − 实收，由平台承担。
  /// 没有这一列时，上限「是安全网还是常态折扣」完全看不出来 ——
  /// 实测 copy_intro 10/10 次调用都被截断 3 积分，而日志里毫无痕迹。
  absorbedBeans       BigInt   @default(0) @map("absorbed_beans")
  beanBucket          String?  @map("bean_bucket") @db.VarChar(16)
  latencyMs           Int      @default(0) @map("latency_ms") @db.UnsignedInt()
  status              String   @db.VarChar(16)
  errorCode           String?  @map("error_code") @db.VarChar(64)
  errorMsg            String?  @map("error_msg") @db.VarChar(1000)
  promptSnapshot      String?  @map("prompt_snapshot") @db.MediumText
  responseSnapshot    String?  @map("response_snapshot") @db.MediumText
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(3)

  merchant Merchant?  @relation(fields: [merchantId], references: [id])
  provider AiProvider @relation(fields: [providerId], references: [id])
  model    AiModel    @relation(fields: [modelId], references: [id])

  @@unique([merchantId, sceneCode, requestId])
  @@index([merchantId, createdAt])
  @@index([providerId, createdAt])
  @@index([createdAt, costFen])
  /// 运营按场景看「平台补贴」用
  @@index([sceneCode, createdAt])
  @@map("ai_call_log")
}

model SystemSetting {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt()
  groupKey    String   @map("group_key") @db.VarChar(64)
  settingKey  String   @map("setting_key") @db.VarChar(64)
  settingVal  String   @map("setting_val") @db.Text
  valueType   String   @default("STRING") @map("value_type") @db.VarChar(16)
  displayName String   @map("display_name") @db.VarChar(128)
  description String?  @db.VarChar(500)
  sort        Int      @default(0)
  isPublic    Boolean  @default(false) @map("is_public")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([groupKey, settingKey])
  @@map("system_setting")
}

model TtsProvider {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt()
  code              String   @unique @db.VarChar(32)
  name              String   @db.VarChar(128)
  appId             String?  @map("app_id") @db.VarChar(64)
  secretIdEncrypted Bytes?   @map("secret_id_encrypted") @db.VarBinary(1024)
  apiKeyEncrypted   Bytes?   @map("api_key_encrypted") @db.VarBinary(1024)
  voiceId           String?  @map("voice_id") @db.VarChar(64)
  extraJson         Json?    @map("extra_json")
  enabled           Boolean  @default(false)
  priority          Int      @default(100)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([enabled, priority])
  @@map("tts_provider")
}

model SmsCode {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt()
  phone     String    @db.VarChar(20)
  codeHash  String    @map("code_hash") @db.VarChar(128)
  scene     String    @default("LOGIN") @db.VarChar(24)
  ip        String?   @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  attempts  Int       @default(0) @db.UnsignedTinyInt()
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([phone, scene, createdAt])
  @@map("sms_code")
}

model AdminUser {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt()
  username     String    @unique @db.VarChar(64)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  displayName  String?   @map("display_name") @db.VarChar(64)
  status       String    @default("ACTIVE") @db.VarChar(16)
  lastLoginAt  DateTime? @map("last_login_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@map("admin_user")
}

model SubscribeMessageRecord {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt()
  merchantId   BigInt    @map("merchant_id") @db.UnsignedBigInt()
  templateCode String    @map("template_code") @db.VarChar(64)
  wxTemplateId String    @map("wx_template_id") @db.VarChar(128)
  grantedCount Int       @default(0) @map("granted_count") @db.UnsignedTinyInt()
  usedCount    Int       @default(0) @map("used_count") @db.UnsignedTinyInt()
  expiredAt    DateTime? @map("expired_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([merchantId, templateCode])
  @@index([templateCode, grantedCount, usedCount])
  @@map("subscribe_message_record")
}

/// 运维告警 —— 支付链路上「只能靠人发现」的异常的唯一出口。
///
/// ★ 为什么必须有**落库**这一层（不能只推 webhook）：
///   webhook 会失败、会被人忽略、会被撤回；而「扣款成功但开通失败」这类事件
///   每一笔都对应真金白银，必须能事后逐笔查证、能标记已处理、能看见处理人。
///   推送只是**触达**手段，落库才是**事实**。
///
/// ★ 去重口径（见 ops-alert.service.ts）：同一个 `dedupeKey` 在去重窗口内重复触发
///   只累加 `occurrences` + 刷新 `lastSeenAt`，**不新增行、不重复推送**。
///   回滚到「未处理 + 窗口内」才重新计一条。已 ack 的键再次出现会**新开一条**
///   （说明问题复发，必须重新提醒）。
///
/// ★ 刻意不建外键：告警必须能在**任何**数据状态下写入成功。
///   若为一行已被清理的订单建了 FK，告警本身就会写失败 —— 恰恰在最需要它的时刻。
model OpsAlert {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt()
  /// 稳定类型标识（代码里判断 / 后台筛选用），如 PAY_AMOUNT_MISMATCH
  code        String    @db.VarChar(48)
  /// CRITICAL = 涉及资金，必须人工介入；WARN = 需要关注但不一定动账
  severity    String    @default("WARN") @db.VarChar(16)
  /// 一句话标题（会原样进推送正文）
  title       String    @db.VarChar(200)
  /// 详情：订单号、金额、具体原因
  detail      String?   @db.Text
  /// 关联对象，供后台跳转
  refType     String?   @map("ref_type") @db.VarChar(32)
  refId       String?   @map("ref_id") @db.VarChar(64)
  dedupeKey   String    @map("dedupe_key") @db.VarChar(160)
  occurrences Int       @default(1)
  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.DateTime(3)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.DateTime(3)
  /// PENDING / SENT / SKIPPED（未配置推送渠道）/ FAILED
  pushStatus  String    @default("PENDING") @map("push_status") @db.VarChar(16)
  pushError   String?   @map("push_error") @db.VarChar(500)
  ackedAt     DateTime? @map("acked_at") @db.DateTime(3)
  ackedBy     BigInt?   @map("acked_by") @db.UnsignedBigInt()
  ackNote     String?   @map("ack_note") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  // 去重查询的走法：dedupeKey + ackedAt IS NULL + lastSeenAt >= 窗口起点
  @@index([dedupeKey, ackedAt, lastSeenAt])
  // 后台默认视图：未处理的按时间倒序
  @@index([ackedAt, createdAt])
  @@index([code, lastSeenAt])
  @@map("ops_alert")
}
