# ═══════════════════════════════════════════════════════════════
# 服务器端 server/.env 模板（体验版测试期）
# 用法：复制到服务器 /opt/dashuai/server/.env，替换所有 REPLACE_*
#      chmod 600 /opt/dashuai/server/.env
# ═══════════════════════════════════════════════════════════════

# ───────── 服务基础 ─────────
# 现在可以用 production 了。
#
# 原先的绕法是把 NODE_ENV 写成 staging —— 但 NODE_ENV 是**全部** fail-closed 校验的
# 唯一开关（JWT_SECRET / APP_MASTER_KEY / CORS_ORIGIN / DEV_LOGIN / MOCK_AI /
# FFMPEG_WORKER / STORAGE_MODE / COS），写 staging 等于把这些安全守卫一起关掉。
#
# 从 2026-09-14 起，支付校验已用 PAYMENTS_ENABLED 单独解耦（见下方说明），
# 所以商户号下来前也能安心用 production，其余守卫全部正常生效。
NODE_ENV=production
PORT=3000

# ───────── 支付总开关（P1-7 新增）─────────
# false = 关闭**真实微信支付能力**：跳过「微信支付七项凭据」校验，服务器正常启动，
#         所有真实支付下单被拒绝（业务码 3008）。适用场景：商户号申请中线上灰度。
# true / 不设置 = 强制校验支付七项凭据，缺一项拒绝启动。
#
# ⚠ 这行**不影响非生产环境的演示支付**（PAYMENT_MODE=test 的自动置 PAID），
#   那是开发联调必需的，且被 NODE_ENV !== production 单独锁死，生产永远拿不到。
#
# 商户号下来后：把下面改成 true（或删掉这行），并补齐文末的 WX_PAY_* 七项。
PAYMENTS_ENABLED=false

# 必须显式列出，禁止用 *（生产校验也会拒绝 *）
CORS_ORIGIN=https://admin.REPLACE_DOMAIN

# ───────── 数据库 / 缓存 ─────────
DATABASE_URL="mysql://dashuai:REPLACE_DB_PASSWORD@127.0.0.1:3306/dashuai?connection_limit=20"
REDIS_URL="redis://127.0.0.1:6379"

# ───────── 鉴权 ─────────
# 生成：openssl rand -hex 32（至少 32 字符，不能含 dev-insecure / please-change 等字样）
JWT_SECRET="REPLACE_openssl_rand_hex_32"

# ───────── 登录策略 ─────────
# 公网域名上必须 false。为 true 时任何人用任意手机号即可建号（POST /auth/dev-login）。
DEV_LOGIN=false
# PAYMENT_MODE 只在 PAYMENTS_ENABLED=true 时有意义（production 下要求 real）。
# 当前支付已灰度关闭，故留空；商户号下来后与 PAYMENTS_ENABLED 一起改。
# PAYMENT_MODE=real

# ───────── 微信小程序（企业主体）─────────
WX_APPID="wx3004f53da3e30a36"
WX_SECRET="REPLACE_小程序AppSecret"
# 体验版登录走「微信一键登录」：openType=getPhoneNumber + wx.login → POST /auth/wechat-login
# 前提：小程序后台已申请并开通「手机号快速验证」能力（按次付费），
#       且已在【开发管理 → 用户隐私保护指引】声明「手机号」（否则点击无任何回调）。
#
# ───────── 短信登录（备选通道 · 腾讯云短信）─────────
# 为什么需要：微信一键登录只能登**本人**微信绑定的号，员工帮店主管理 / 代运营无法登他人账号。
# 管理后台不接短信（只有管理员，用 ADMIN_USERNAME/PASSWORD）。
# 详见 deploy/短信登录接入清单.md。
# 五项缺任一即视为「通道未配置」→ 短信入口返回 1004/503，
# 但**不会阻止服务启动**（备选通道不可用不该影响主通道，故刻意不做 fail-closed 硬校验）。
SMS_PROVIDER=tencent
TENCENT_SMS_SDK_APP_ID="1401194004"
# ⚠ 签名名必须与腾讯云侧**已过审**的那条**逐字一致**（含地域前缀）：
#   第一次提交的 `大帅餐饮管理` 已被驳回，后来改名为 `廊坊大帅餐饮管理`（同一个 SignId 721922）才过审。
#   写错不报「签名不对」，只会静默发不出去 ⇒ 改名前先跑 `npm run sms:status` 核对。
TENCENT_SMS_SIGN_NAME="廊坊大帅餐饮管理"
# ⚠ 以下三项是凭据，本文件提交进仓库（仓库为 public）⇒ 只留空，真值填服务器上的 .env
TENCENT_SMS_SECRET_ID=""
TENCENT_SMS_SECRET_KEY=""
# 模板正文：验证码为：{1}，您正在登录，若非本人操作，请勿泄露。
# ⚠ 只有一个变量 {1} ⇒ 代码 TemplateParamSet 只能传 1 个参数（多传少传都报 TemplateParamInconsistent）
TENCENT_SMS_TEMPLATE_ID=""
# 国内短信固定广州；仅国际/港澳台短信才需改
# TENCENT_SMS_REGION=ap-guangzhou

# ───────── 开发登录后门（体验版测试期专用 · 用完必删）─────────
# 背景（2026-09-18）：小程序备案中 ⇒ 公网只能走 IP 直连，而「微信一键登录」同时要求
#   ① 小程序已认证、② 走 https 正式域名 ⇒ 体验版在真机上根本拿不到 code。
#   结果：测试者**两条正式通道都进不来**。本节是测试期的临时口子。
#
# 四道闸门（缺一即整块失效，绝不降级为"部分生效"）：
#   ① 环境：NODE_ENV=production 时**默认整块关闭**。要在线上开，必须再写一行
#      SMS_TEST_CODE_ALLOW_PROD=true 显式声明破例 —— 防的是"把本地 .env 整份复制上服务器"。
#   ② 值形态：SMS_TEST_CODE 必须是 6 位数字（/^\d{6}$/），写 "true"/"12345" 都不生效。
#   ③ 白名单必填：SMS_TEST_CODE_PHONES 非空才生效。
#      ⚠ 代码**故意不支持**"留空 = 所有号" —— 让无差别后门在配置里就表达不出来。
#   ④ 取码顺序：固定码是在"点获取验证码"那一刻写库的
#      ⇒ 必须**先加白名单、再点获取**。反了的话报的是"验证码错误或已过期"，看不出真因。
#
# 测试者怎么用：用自己的号点「获取验证码」（不会真发短信）→ 输入下面的固定码 → 登录。
SMS_TEST_CODE=""
SMS_TEST_CODE_PHONES=""
SMS_TEST_CODE_ALLOW_PROD=""
#
# ⚠ 备案 / 微信认证通过后，必须把这 3 个变量**一起**删掉。
#   只删其中一两个 = 白名单号仍能用固定码登录 = 后门还开着。
#
# 与上方「登录策略」段的 DEV_LOGIN 的区别（两者别混）：
#   · DEV_LOGIN=true —— 任意手机号免验证码直接建号，**公网绝对不能开**，只给本机开发。
#   · 本节测试码 —— 只认白名单，给体验版测试者用；开了也必须留 true 的 ALLOW_PROD 才在线上生效。

# ───────── AI 通道主密钥（AES-256-GCM）─────────
# 必须是 64 位十六进制：openssl rand -hex 32
# ⚠ 改了此密钥必须重新 db:seed 重加密通道 Key；泄露等于所有 AI Key 泄露
APP_MASTER_KEY="REPLACE_openssl_rand_hex_32"

# ───────── 渲染 ─────────
FFMPEG_WORKER=true
# 生产禁用 local：素材必须走 COS，否则真机播放地址是 127.0.0.1 无法打开
STORAGE_MODE=cos
# 字幕烧录依赖 libass，Debian/Ubuntu apt 装的 ffmpeg 已包含
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
# 合成卡死回收阈值（默认 30 分钟超时、5 分钟扫一次，按需调）
# RENDER_STUCK_MS=1800000
# RENDER_STUCK_SWEEP_MS=300000

# ───────── 对象存储 ─────────
COS_BUCKET="REPLACE_bucket-appid"
COS_REGION="REPLACE_ap-beijing"
COS_SECRET_ID="REPLACE"
COS_SECRET_KEY="REPLACE"
COS_BASE_URL="https://REPLACE_bucket-appid.cos.REPLACE_ap-beijing.myqcloud.com"

# ───────── AI（真实通道）─────────
DEEPSEEK_API_KEY="REPLACE_DeepSeek_Key"
MOCK_AI=false
# AI 通道本身存在数据库 ai_provider 表里、用 APP_MASTER_KEY 加密，
# 需在运营后台「供应商配置」里录入并 enabled，环境变量只是兜底。

# ───────── 运营后台 ─────────
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="REPLACE_强口令"

# ───────── 微信支付（商户号下来后填，并把 PAYMENTS_ENABLED 改为 true / 删除该行）─────────
# 共七项 + 一个开关。注意两套密钥方向相反，别搞混：
#   · 商户 API 证书（WX_PAY_PRIVATE_KEY + WX_PAY_SERIAL_NO）——代表**商户侧**身份，
#     用于我们对微信发起的**请求签名**。来源：「API安全 → 申请API证书」下载的 zip。
#   · 微信侧验签凭据（WX_PAY_PLATFORM_CERT）——代表**微信侧**身份，
#     用于验证微信下发给我们的**回调与响应签名**。
#
# ⚠ WX_PAY_PLATFORM_CERT 这个名字是历史遗留：它装的是「微信侧公钥材料」，
#   两种形态都合法，微信对同一商户**只启用其中一种**：
#     ① 微信支付平台证书（-----BEGIN CERTIFICATE-----，5 年有效期，需用
#        GET /v3/certificates 定期轮换）
#     ② 微信支付公钥（-----BEGIN PUBLIC KEY-----，**不过期**，2024 年底起微信主推）
#   实证（2026-09-15，商户 1750405417）：该商户调 GET /v3/certificates 返回
#     404 RESOURCE_NOT_EXISTS「无可用的平台证书，请在商户平台-API安全申请使用微信支付公钥」
#   —— 即**新注册商户默认只有公钥**，此时该项填「微信支付公钥」PEM。
#   可从「账户中心 → API安全 → 微信支付公钥管理 → 查看/下载公钥」获取（文件名常为 wxp_pub.pem），
#   同页还会显示**公钥 ID**（形如 PUB_KEY_ID_0114...），后续排查问题时用得上。
#
# ⚠ WX_PAY_PRIVATE_KEY 与 WX_PAY_PLATFORM_CERT 都是多行 PEM，在 .env 里必须写成**单行**、
#   换行用字面 \n（代码里 replace(/\\n/g,'\n') 还原）。生成单行的命令：
#     awk 'NF {sub(/\r/, ""); printf "%s\\n", $0}' apiclient_key.pem
WX_PAY_MCH_ID=""
WX_PAY_API_KEY_V3=""
WX_PAY_SERIAL_NO=""
WX_PAY_PRIVATE_KEY=""
WX_PAY_PLATFORM_CERT=""
WX_PAY_NOTIFY_URL="https://api.REPLACE_DOMAIN/api/v1/pay/notify"
# 微信支付公钥 ID（**可选**，不是密钥材料、不能替代上面的公钥 PEM）。
# 用途：① 微信在响应/回调的 `Wechatpay-Serial` 头里用它指明本次签名用的钥匙；
#       ② 商户向上送**加密敏感信息**时要带 `Wechatpay-Serial: <公钥ID>` 指明用哪个公钥加密。
# 本项目的 JSAPI 下单 + 回调**不需要发这个头**，配上只是为了在日志里核对回调头，
# 便于真机排查（`routes/pay.ts` 会打印，但**从不**据此拒绝回调 —— 灰度期该头可能为
# 平台证书序列号，据此拒绝会误杀合法回调）。实测本商户（1750405417）微信响应该头即为该值。
WX_PAY_PUBLIC_KEY_ID=""
